# Copy this file to .env and fill in your MongoDB Atlas connection string.
PORT=5000
# Bind to all interfaces so phones on the same Wi-Fi/hotspot can reach the API.
HOST=0.0.0.0
# Optional comma-separated list of allowed origins. Leave unset to allow all.
# CORS_ORIGIN=http://localhost:8081,https://app.example.com
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexora?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
