# Copy this file to .env and fill in the values below.
# The app uses these variables at runtime — never commit real secrets.

# ── Server ──────────────────────────────────────────────────────────────
# Port the API listens on. Defaults to 5000 if unset.
PORT=5000

# Host to bind the server to. 0.0.0.0 makes the API reachable from
# any device on the same Wi‑Fi / hotspot (required for Expo Go / Android).
HOST=0.0.0.0

# Optional: restrict CORS to specific origins (comma‑separated).
#   Example: CORS_ORIGIN=http://localhost:8081,https://app.example.com
#   Leave unset to allow all origins (suitable for native Expo Go apps).
CORS_ORIGIN=

# ── Security ────────────────────────────────────────────────────────────
# JWT secret used for signing auth tokens.
# Generate a long random string (e.g., `openssl rand -hex 32`).
JWT_SECRET=replace_with_a_long_random_secret

# ── Database ────────────────────────────────────────────────────────────
# MongoDB Atlas connection string.
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexora?retryWrites=true&w=majority
# If unset, the server falls back to the local offline data store.
MONGODB_URI=mongodb+srv://saijanjirala5411_db_user:8rZupWnUNOaQBAT8@cluster0.ou9x9ah.mongodb.net/nexora?retryWrites=true&w=majority

# ── Optional: Cloud Storage ────────────────────────────────────────────
# If you plan to upload files (avatars, attachments, etc.), configure your
# cloud provider below. Local `uploads/` directories will not persist across
# dyno restarts or container redeploys.
#
# Cloudinary (recommended for images):
#   CLOUDINARY_CLOUD_NAME=your_cloud_name
#   CLOUDINARY_API_KEY=your_api_key
#   CLOUDINARY_API_SECRET=your_api_secret
#
# AWS S3:
#   AWS_ACCESS_KEY_ID=your_key
#   AWS_SECRET_ACCESS_KEY=your_secret
#   AWS_BUCKET=your_bucket_name
#   AWS_REGION=us-east-1